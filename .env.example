APP_NAME="CEMWP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Buka aplikasi lewat alamat INI PERSIS (127.0.0.1 dan localhost dianggap situs berbeda oleh browser).
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (buat dulu database kosong di PostgreSQL: CREATE DATABASE cemwp;) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cemwp
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=file
SESSION_LIFETIME=120
# PENTING utk PRODUCTION: true bila situs memakai HTTPS (cookie sesi tidak dikirim lewat HTTP biasa).
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
# sync = jalan langsung (cukup untuk saat ini). Saat modul Sales/Marketing hadir: database + `php artisan queue:work`.
QUEUE_CONNECTION=sync

# --- Email sistem (kode OTP login, reset password) lewat Gmail API ---
MAIL_MAILER=gmail_api
MAIL_FROM_ADDRESS="noreply@cemwp.local"
MAIL_FROM_NAME="CEMWP"

# CARA TERCEPAT: salin credentials.json + token.json dari proyek SDM/MKP yang sudah jalan
# ke storage/app/credentials/  (tidak perlu isi apa pun di bawah ini).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Bila muncul error SSL "cURL error 60" (Windows/XAMPP), isi path file cacert.pem:
GMAIL_CA_BUNDLE=
# Mode lokal: kalau Gmail belum siap, kode OTP dicatat di storage/logs/laravel.log (hanya APP_ENV=local)
GMAIL_LOCAL_LOG_FALLBACK=true

# --- Warehouse ---
CEMWP_DEFAULT_WAREHOUSE=GD-UTAMA
# Reservasi stok checkout e-commerce yang belum dibayar kedaluwarsa setelah N menit
CEMWP_RESERVATION_TTL_MINUTES=30
CEMWP_PER_PAGE=25
# Token API (Sanctum) kedaluwarsa dalam menit (default 30 hari)
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
CEMWP_API_TOKEN_TTL_MINUTES=43200
# Isi hanya bila ada aplikasi WEB di domain lain yang memanggil /api/v1/*, mis. https://portal.contoh.com
CORS_ALLOWED_ORIGINS=

# --- Keamanan tambahan untuk PRODUCTION ---
CEMWP_CSP=off
CEMWP_FORCE_HTTPS=false

# --- Hashing password: argon2id (ganti ke bcrypt hanya bila PHP belum mendukung Argon2) ---
HASH_DRIVER=argon2id
ARGON_MEMORY=37888
ARGON_TIME=3
ARGON_THREADS=1

# Super-admin awal, dibuat otomatis saat `php artisan migrate --seed` (tanpa OTP untuk pertama kali)
CEMWP_ADMIN_NAME="Administrator"
CEMWP_ADMIN_EMAIL=
CEMWP_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# --- Sales (POS & toko online) ---
CEMWP_STORE_NAME="Toko Kopi CEMWP"
CEMWP_STORE_ADDRESS=""
CEMWP_STORE_PHONE=""
CEMWP_RECEIPT_FOOTER="Terima kasih sudah berbelanja!"
# Batas waktu bayar pesanan online (menit); stok dicadangkan selama itu
CEMWP_ORDER_TTL_MINUTES=60
# PPN tambahan (persen) di atas harga jual. 0 = harga sudah final
CEMWP_TAX_RATE=0
CEMWP_BANK_TRANSFER_INFO="Transfer ke BCA 000-000-0000 a.n. Nama Toko"
CEMWP_PUBLIC_STOCK_CAP=50

# --- Midtrans (opsional; aktifkan metode "MIDTRANS" di Sales > Pengaturan setelah kunci diisi) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
